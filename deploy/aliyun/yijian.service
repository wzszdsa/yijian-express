[Unit]
Description=YiJian parcel service
After=network-online.target mariadb.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/yijian
EnvironmentFile=/etc/yijian/yijian.env
ExecStart=/usr/bin/node /opt/yijian/server-dist/index.mjs
Restart=on-failure
RestartSec=5
User=root
Group=root
UMask=0027

[Install]
WantedBy=multi-user.target
