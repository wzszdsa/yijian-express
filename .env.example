# Node 通过本机 HTTP 代理访问 Resend 时启用；没有代理可删除或改为 0。
NODE_USE_ENV_PROXY=1

# 留空时使用当前站点的同源 /api 接口；生产域名为 https://wzzsl.fun
VITE_API_BASE_URL=
# 仅开发环境启用 Vite-only 演示认证；生产构建不会启用演示登录。
VITE_ENABLE_DEMO_AUTH=true

# 本地开发不连接线上数据库，使用本地 JSON 记录。
STORAGE_PROVIDER=local

# ── 数据库连接约定 ──────────────────────────────────────────────
# 项目支持多环境文件，通过 ENV_FILE 选择（server/index.mts 已内置支持）：
#
#   .env         默认加载。当前指向阿里云 RDS（大陆杭州），即默认使用云端数据库。
#   .env.local   可选。指向本机 MySQL，仅在需要脱离云端调试时使用。
#
# 迁移到中国香港 ECS 后，数据库改为同机自建 MariaDB，
# 连接地址变为 mysql://…@127.0.0.1:3306/yijian（见 deploy/hongkong/README.md）。
#
# 切换方式（不改代码）：
#   node server-dist/index.mjs                      # 用 .env（RDS）
#   ENV_FILE=.env.local node server-dist/index.mjs  # 用本机 MySQL
#
# MYSQL_URL 格式：mysql://用户名:密码@主机:3306/数据库名
# 密码含特殊字符时按 URL 规则编码（如 ! 写成 %21），代码用 decodeURIComponent 还原。
# 启用 TLS 可用 mysqls:// 前缀，或设置 MYSQL_SSL=true。
#
# ⚠️ .env 与 .env.local 含明文密码，已被 .gitignore 的 `.env.*` 规则忽略，切勿提交。

# 本地没有邮件服务密钥时，使用 console 演示模式。
EMAIL_PROVIDER=console
AUTH_EXPOSE_DEMO_CODE=true

# 生产环境（中国香港 ECS）使用同机 MariaDB；密码只写在服务器 /etc/yijian/yijian.env。
# 完整部署流程见 deploy/hongkong/README.md。
# NODE_ENV=production
# APP_HOST=127.0.0.1      # 只接受本机 Nginx 转发，不直接对外
# PORT=3000               # 需与 Nginx 的 proxy_pass 一致
# PUBLIC_ORIGIN=https://wzzsl.fun
# WEB_ROOT=/opt/yijian/dist
# STORAGE_PROVIDER=mysql
# MYSQL_URL=mysql://yijian_app:数据库密码@127.0.0.1:3306/yijian
# MYSQL_CONNECTION_LIMIT=8
# EMAIL_PROVIDER=resend
# RESEND_TOKEN=只放在服务器环境变量中
# EMAIL_FROM=no-reply@wzzsl.cloud
# 域名分工（勿混用）：
#   wzzsl.cloud —— 仅用于 Resend 发件，只需 SPF/DKIM 记录，不需要 A 记录；
#   wzzsl.fun   —— 站点与 App 的访问域名，需 A 记录指向服务器。
# EMAIL_SUBJECT=驿见邮箱验证码
# AUTH_EXPOSE_DEMO_CODE=false
# 快递100服务端凭证；不要使用 VITE_ 前缀，不要提交到 Git。
# KUAIDI100_KEY=快递100授权key
# KUAIDI100_CUSTOMER=快递100customer编码
# KUAIDI100_TRACK_QUERY_URL=https://poll.kuaidi100.com/poll/query.do
# 可选：开通快递100「行政区域解析」后设置，接口返回坐标时前端会展示地图轨迹。
# 合法取值（官方文档）：1=行政区域解析+物流状态名称；4=1的基础上再加高级状态值与出发/目的/当前城市，
#   并返回 areaCenter 经纬度（地图轨迹需要这个）；8=4的基础上再加预计到达时间与预估轨迹。
# ⚠️ 注意：只有 4 和 8 会返回 areaCenter 坐标，设成 1 拿不到坐标；5 不是合法值。
# 未设置时接口不返回任何坐标，前端地图会显示「承运商未返回坐标」。
# KUAIDI100_RESULTV2=4
