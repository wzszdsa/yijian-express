    "lucide-react": "^1.42.0",
    "mysql2": "^3.24.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "resend": "^6.26.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "oxlint": "^1.79.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.2"
  }
}
