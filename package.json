{
  "name": "purchase",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && npm run typecheck:server && vite build && npm run build:server",
    "lint": "oxlint",
    "preview": "vite preview",
    "build:server": "tsc -p tsconfig.server.json",
    "typecheck:server": "tsc -p tsconfig.server.json --noEmit",
